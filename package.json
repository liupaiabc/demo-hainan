{
  "name": "react-koa-starter",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "overrides": {
    "source-map-js": "1.2.1"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "npm run start -w server",
    "db:up": "docker compose --env-file server/.env up -d db",
    "db:down": "docker compose --env-file server/.env down",
    "db:setup": "npm run db:setup -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
