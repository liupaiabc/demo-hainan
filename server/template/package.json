{
  "name": "update-doc-from-xlsx",
  "version": "1.0.0",
  "description": "Read Excel data as JSON and fill Word templates from cell references.",
  "main": "update-doc.js",
  "scripts": {
    "start": "node update-doc.js",
    "deepseek": "node deepseek.js",
    "xlsx:json": "node update-doc.js test.xlsm",
    "template:doc": "node update-doc.js test.xlsm template-test.doc"
  },
  "keywords": [
    "xlsx",
    "docx",
    "json",
    "excel"
  ],
  "license": "MIT",
  "dependencies": {
    "cfb": "^1.2.2",
    "jszip": "^3.10.1",
    "xlsx": "^0.18.5"
  }
}
